{
  "name": "framecut",
  "private": true,
  "version": "0.2.0",
  "description": "Split negative roll scan TIFFs into individual pixel-exact frames, locally in Chrome.",
  "license": "MIT",
  "author": "Chris Wu",
  "repository": {
    "type": "git",
    "url": "https://github.com/stabruriss/framecut.git"
  },
  "bugs": {
    "url": "https://github.com/stabruriss/framecut/issues"
  },
  "homepage": "https://github.com/stabruriss/framecut#readme",
  "type": "module",
  "scripts": {
    "build:engine": "./scripts/build-libtiff-engine.sh",
    "prepare:vips": "node scripts/prepare-vips.mjs",
    "stamp:sw": "node scripts/stamp-service-worker.mjs",
    "predev": "npm run prepare:vips",
    "dev": "vite",
    "prebuild": "npm run prepare:vips",
    "build": "tsc -b && vite build && npm run stamp:sw",
    "build:single": "tsc -b && vite build --config vite.single.config.ts",
    "smoke:engine": "node scripts/engine-smoke.mjs",
    "preview": "vite preview",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "engines": {
    "node": "^20.19.0 || >=22.12.0"
  },
  "dependencies": {
    "@fontsource-variable/archivo": "^5.3.0",
    "@fontsource-variable/newsreader": "^5.3.0",
    "fflate": "0.8.2",
    "lucide-react": "^1.27.0",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "wasm-vips": "0.0.18"
  },
  "devDependencies": {
    "@types/node": "^24.10.1",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^5.2.0",
    "typescript": "^6.0.2",
    "vite": "^7.3.6",
    "vite-plugin-singlefile": "2.3.3",
    "vitest": "^4.1.10"
  }
}
